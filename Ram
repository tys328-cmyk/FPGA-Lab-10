module RAM(
    input i_clk,
    input i_rst,
    input [2:0] i_addr,
    input [7:0] i_write_data,
    input i_write_en,
    input i_read_en,
    output reg [7:0] o_read_data
);

parameter DATA_W = 8;
parameter SIZE = 8;
parameter ADDR_W = 3;

reg [DATA_W-1:0] mem [0:SIZE-1];

integer i;

always @(posedge i_clk) begin
    if (i_rst) begin
        for (i = 0; i < SIZE; i = i + 1)
            mem[i] <= 0;

        o_read_data <= 0;
    end
    else if (i_write_en) begin
        mem[i_addr] <= i_write_data;
    end
    else if (i_read_en) begin
        o_read_data <= mem[i_addr];
    end
end

endmodule

