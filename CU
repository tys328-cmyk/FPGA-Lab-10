module cu(
    input clk, reset, enable,
    input [2:0] adr1, adr2,
    output reg w_rf,
    output reg [2:0] adr,
    output reg DA, SA, SB,
    output reg [2:0] st_out,
    output reg w_ram,
    output reg r_ram
);

parameter S0_idle      = 3'd0,
          S1_send_adr1 = 3'd1,
          S2_send_adr2 = 3'd2,
          S3_multiply  = 3'd3,
          S4_write_ram = 3'd4,
          S5_read_ram  = 3'd5;

reg [2:0] PS, NS;

always @(posedge clk or posedge reset) begin
    if (reset)
        PS <= S0_idle;
    else if (enable)
        PS <= NS;
end

always @(*) begin
    NS = PS;
    w_rf = 0;
    w_ram = 0;
    r_ram = 0;
    adr = 0;
    DA = 0;
    SA = 0;
    SB = 1;
    st_out = PS;

    case (PS)
        S0_idle: begin
            NS = S1_send_adr1;
        end

        S1_send_adr1: begin
            adr = adr1;
            w_rf = 1;
            DA = 0;
            NS = S2_send_adr2;
        end

        S2_send_adr2: begin
            adr = adr2;
            w_rf = 1;
            DA = 1;
            NS = S3_multiply;
        end

        S3_multiply: begin
            NS = S4_write_ram;
        end

        S4_write_ram: begin
            w_ram = 1;
            NS = S5_read_ram;
        end

        S5_read_ram: begin
            r_ram = 1;
            NS = S0_idle;
        end

        default: begin
            NS = S0_idle;
        end
    endcase
end

endmodule


